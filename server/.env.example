# 家宴小本子服务端 — 环境变量示例
# 请勿在此文件写入真实密钥！复制为 .env 后填入实际值。

# 服务端口
PORT=3000

# JWT 签名密钥（务必修改为随机长字符串）
JWT_SECRET=change-me-to-a-random-secret

# 微信小程序配置（生产环境必填）
# 在微信公众平台 → 开发管理 → 开发设置 获取
WECHAT_APP_ID=wx_your_app_id_here
WECHAT_APP_SECRET=your_app_secret_here

# 测试模式：设为 true 后可用 test_openid_xxx 格式的 code 直接登录
# 生产环境必须设为 false 或删除此变量
WECHAT_TEST_MODE=false

# SQLite 数据库文件路径
DB_PATH=./data/jiayan.db

# JWT 有效期（默认 7 天）
JWT_EXPIRES_IN=7d

# 分享默认有效期（默认 7 天）
SHARE_EXPIRES_IN_DAYS=7
