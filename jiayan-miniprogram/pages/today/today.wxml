<view class="pad col" style="gap:32rpx;padding-bottom:60rpx">

  <view class="row" style="gap:24rpx;border-bottom:2rpx solid #DCD3C2;padding-bottom:28rpx">
    <view style="width:88rpx;height:88rpx;border:3rpx solid #A93226;border-radius:50%;color:#A93226;display:flex;align-items:center;justify-content:center;font-size:24rpx;transform:rotate(-8deg)">定</view>
    <view class="col flex1" style="gap:4rpx">
      <view style="font-size:34rpx;font-weight:600">{{dateLabel}} 晚餐</view>
      <view style="font-size:24rpx;color:#8A8072">两人 · 预计 {{minutes}} 分钟</view>
    </view>
  </view>

  <view class="col" style="gap:24rpx">
    <view class="row" style="gap:24rpx" wx:for="{{list}}" wx:key="name" bindtap="openDish" data-name="{{item.name}}">
      <view class="ph" style="width:132rpx;height:132rpx"></view>
      <view class="col flex1" style="gap:8rpx">
        <view style="font-size:34rpx;font-weight:600">{{item.name}}</view>
        <view style="font-size:22rpx;color:#8A8072">{{item.tag}} · {{item.kcal}} 千卡</view>
      </view>
      <view style="font-size:26rpx;color:#B6AB98;padding:0 8rpx" catchtap="remove" data-name="{{item.name}}">×</view>
    </view>
  </view>

  <view class="card col" style="padding:28rpx;gap:20rpx">
    <view class="label">这一餐合计</view>
    <view class="row" style="align-items:flex-end;gap:12rpx">
      <view style="font-size:64rpx;font-weight:600;line-height:1">{{totalKcal}}</view>
      <view style="font-size:24rpx;color:#6B6355;padding-bottom:8rpx">千卡 · 每人约 {{perPerson}} 千卡</view>
    </view>
    <view class="row" style="height:16rpx">
      <view style="width:33%;background:#1F1C18"></view>
      <view style="width:34%;background:#6B6355"></view>
      <view style="width:33%;background:#A93226"></view>
    </view>
    <view style="font-size:22rpx;color:#8A8072">三大营养素挺均衡，今天可以放心吃</view>
  </view>

  <view class="col" style="gap:16rpx">
    <view class="label">要买的</view>
    <view style="font-size:26rpx;line-height:2;color:#3A342B">{{shopping}}</view>
  </view>

  <view class="row" style="gap:20rpx;margin-top:16rpx">
    <view hover-class="hv" class="btn btn-ghost flex1" bindtap="back">再改改</view>
    <view hover-class="hv" class="btn btn-red flex1" bindtap="cook">开始做饭</view>
  </view>

</view>
