<view class="ph" style="height:520rpx;position:relative;font-size:22rpx">
  菜品主图
  <view wx:if="{{d.status === '常做'}}" style="position:absolute;bottom:28rpx;right:32rpx;width:104rpx;height:104rpx;border:3rpx solid #A93226;border-radius:50%;color:#A93226;display:flex;align-items:center;justify-content:center;font-size:26rpx;background:rgba(244,239,229,.75);transform:rotate(-8deg)">常做</view>
</view>

<view class="pad col" style="gap:28rpx;padding-bottom:200rpx">
  <view class="col" style="gap:16rpx">
    <view class="row" style="justify-content:space-between;align-items:baseline">
      <view style="font-size:52rpx;font-weight:600">{{d.name}}</view>
      <view class="row" style="gap:12rpx;align-items:baseline">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{item === pop ? 'pop' : ''}}" style="font-size:32rpx;color:{{item <= rating ? '#A93226' : '#D3CAB8'}}" bindtap="setRating" data-n="{{item}}">★</text>
        <text style="font-size:24rpx;color:#8A8072">{{rating}}.0</text>
      </view>
    </view>
    <view class="row" style="gap:12rpx;flex-wrap:wrap">
      <text class="tag">{{d.flavor}}</text>
      <text class="tag">{{d.cat}}</text>
      <text class="tag">{{d.time}}</text>
      <text class="tag">{{d.level}}</text>
      <text class="tag">他会做</text>
    </view>
  </view>

  <view class="card col" style="padding:28rpx;gap:24rpx">
    <view class="row" style="justify-content:space-between;align-items:baseline">
      <view class="label">热量与营养 / 每份</view>
      <view style="font-size:22rpx;color:#A93226">按食材估算 ›</view>
    </view>
    <view class="row" style="align-items:flex-end;gap:12rpx">
      <view style="font-size:68rpx;font-weight:600;line-height:1">{{d.kcal}}</view>
      <view style="font-size:26rpx;color:#6B6355;padding-bottom:10rpx">千卡 · 约占两人晚餐 {{pct}}%</view>
    </view>
    <view class="col" style="gap:16rpx">
      <view class="row" style="gap:20rpx" wx:for="{{macros}}" wx:key="k">
        <view style="width:68rpx;font-size:24rpx;color:#6B6355">{{item.k}}</view>
        <view class="flex1" style="height:12rpx;background:#E6DFD1"><view class="bar-fill" style="width:{{item.pct}}%;height:12rpx;background:{{item.color}}"></view></view>
        <view style="width:84rpx;text-align:right;font-size:22rpx;font-family:monospace">{{item.g}} g</view>
      </view>
    </view>
  </view>

  <view class="col" style="gap:12rpx">
    <view class="label">食材</view>
    <view style="font-size:28rpx;line-height:2;color:#3A342B">{{d.ingFull}}</view>
  </view>

  <view class="col hr-t" style="gap:16rpx;padding-top:24rpx" wx:if="{{d.log.length}}">
    <view class="label">{{d.made}}</view>
    <view style="font-size:26rpx;color:#6B6355;line-height:1.9">
      <view wx:for="{{d.log}}" wx:key="*this">{{item}}</view>
    </view>
  </view>
</view>

<view style="position:fixed;left:0;right:0;bottom:0;height:144rpx;border-top:2rpx solid #DCD3C2;background:#FBF8F2;display:flex;align-items:center;gap:20rpx;padding:0 36rpx calc(env(safe-area-inset-bottom))">
  <view hover-class="hv" class="btn btn-ghost" style="width:112rpx;height:80rpx;font-size:26rpx" bindtap="want">想吃</view>
  <view hover-class="hv" class="btn btn-red flex1" style="height:80rpx" bindtap="cookToday">今天做这道</view>
  <view hover-class="hv" class="btn btn-ghost" style="width:112rpx;height:80rpx;font-size:26rpx" bindtap="edit">编辑</view>
</view>
