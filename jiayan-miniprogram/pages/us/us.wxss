.cell {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
}
.cell-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  border-radius: 0;
  font-weight: normal;
  text-align: left;
  font-size: 30rpx;
  line-height: inherit;
  color: inherit;
  width: 100%;
}
.cell-btn::after { border: none; }
