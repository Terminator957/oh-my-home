<view class="pad col" style="gap:36rpx">

  <view class="row" style="gap:28rpx;border-bottom:2rpx solid #DCD3C2;padding-bottom:32rpx">
    <view class="row">
      <view class="ph" style="width:104rpx;height:104rpx;border-radius:50%"></view>
      <view class="ph" style="width:104rpx;height:104rpx;border-radius:50%;margin-left:-48rpx"></view>
    </view>
    <view class="col flex1" style="gap:8rpx">
      <view style="font-size:34rpx;font-weight:600">WXJ · WJ</view>
      <view style="font-size:24rpx;color:#8A8072">一起记了 81 道菜</view>
    </view>
  </view>

  <view style="display:grid;grid-template-columns:1fr 1fr;gap:24rpx">
    <view class="card col" style="padding:28rpx;gap:12rpx" wx:for="{{stats}}" wx:key="k">
      <view style="font-size:52rpx;font-weight:600">{{item.v}}</view>
      <view style="font-size:24rpx;color:#6B6355">{{item.k}}</view>
    </view>
  </view>

  <view class="col">
    <button open-type="share" class="cell-btn">
      <view class="cell hr-t">分享菜单给客人<text style="color:#A93226;font-size:26rpx">生成卡片 ›</text></view>
    </button>
    <view class="cell hr-t" bindtap="goOrders">客人点过的菜<text class="muted" style="font-size:26rpx">14 场 ›</text></view>
    <view class="cell hr-t" bindtap="todo">每日热量目标<text class="muted" style="font-size:26rpx">1,900 千卡 ›</text></view>
    <view class="cell hr-t" bindtap="todo">忌口与过敏<text class="muted" style="font-size:26rpx">香菜、花生 ›</text></view>
    <view class="cell hr-t" style="border-bottom:2rpx solid #DCD3C2" bindtap="todo">导出这本菜谱<text class="muted" style="font-size:26rpx">›</text></view>
  </view>

</view>
