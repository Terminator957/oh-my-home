<view class="pad col" style="gap:28rpx;padding-bottom:280rpx">

  <view bindtap="mockPhoto" style="height:300rpx;border:2rpx dashed #C0B5A0;background:#FBF8F2;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;color:#8A8072">
    <view style="font-size:44rpx">＋</view>
    <view style="font-size:26rpx">{{photoTaken ? '已选 1 张 · 点击重选' : '拍照 / 从相册选'}}</view>
    <view class="label" style="letter-spacing:2rpx">上传后自动识别菜名与热量</view>
  </view>

  <view class="col" style="gap:12rpx">
    <view class="label">菜名</view>
    <view class="row" style="height:80rpx;border-bottom:2rpx solid #C9BFAC;justify-content:space-between">
      <input class="flex1" style="font-size:34rpx" value="{{dishName}}" bindinput="onName" />
      <text style="font-size:22rpx;color:#A93226">识别所得 · 可改</text>
    </view>
  </view>

  <view class="col" style="gap:16rpx">
    <view class="label">状态</view>
    <view class="row" style="gap:16rpx">
      <view hover-class="hv" class="btn flex1 {{status === item ? '' : ''}}" wx:for="{{statusOpts}}" wx:key="*this"
        style="height:72rpx;font-size:28rpx;border:2rpx solid {{status === item ? '#A93226' : '#DCD3C2'}};background:{{status === item ? '#A93226' : '#FBF8F2'}};color:{{status === item ? '#FBF8F2' : '#6B6355'}}"
        bindtap="pickStatus" data-s="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="col" style="gap:16rpx">
    <view class="row" style="justify-content:space-between;align-items:baseline">
      <view class="label">食材（填得越全，估算越准）</view>
      <view style="font-size:24rpx;color:#A93226" bindtap="addIng">＋ 加一项</view>
    </view>
    <view class="row" wx:for="{{ings}}" wx:key="index" style="gap:20rpx;border-bottom:2rpx solid #E0D8C6;padding-bottom:14rpx">
      <view class="flex1" style="font-size:28rpx">{{item.name}}</view>
      <view style="font-size:26rpx;color:#6B6355">{{item.amount}}</view>
      <view style="font-size:26rpx;color:#B6AB98;padding:0 8rpx" bindtap="removeIng" data-i="{{index}}">×</view>
    </view>
  </view>

  <view class="col" style="gap:16rpx">
    <view class="label">口味 · 耗时 · 难度</view>
    <view class="row" style="gap:12rpx;flex-wrap:wrap">
      <view hover-class="hv" class="chip {{flavors.indexOf(item) > -1 ? 'on' : ''}}" wx:for="{{flavorOpts}}" wx:key="*this" style="font-size:24rpx;padding:8rpx 20rpx" bindtap="toggleFlavor" data-f="{{item}}">{{item}}</view>
    </view>
  </view>

</view>

<view style="position:fixed;left:0;right:0;bottom:0;border-top:2rpx solid #DCD3C2;background:#FBF8F2;padding:28rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:20rpx">
  <view class="row" style="justify-content:space-between">
    <view style="font-size:26rpx;color:#6B6355">估算热量 <text style="font-size:40rpx;font-weight:600;color:#1F1C18">{{estKcal}}</text> 千卡 / 份</view>
    <view class="label" style="letter-spacing:2rpx">{{estNote}}</view>
  </view>
  <view hover-class="hv" class="btn btn-red" bindtap="analyze">{{analyzed ? '重新分析并保存' : '分析热量'}}</view>
</view>
