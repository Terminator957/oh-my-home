<view class="pad col" style="gap:32rpx">

  <view style="font-size:40rpx;font-weight:600">今晚是什么心情？</view>

  <view class="row" style="gap:16rpx;flex-wrap:wrap">
    <view hover-class="hv" class="chip {{mood === item ? 'on' : ''}}" wx:for="{{moods}}" wx:key="*this" style="font-size:28rpx;padding:16rpx 28rpx" bindtap="pick" data-m="{{item}}">{{item}}</view>
  </view>

  <view class="row hr-t" style="justify-content:space-between;align-items:baseline;padding-top:24rpx">
    <view class="label">{{mood}} · 推荐</view>
    <view style="font-size:22rpx;color:#8A8072">{{list.length}} 道</view>
  </view>

  <view class="col" style="gap:24rpx">
    <view class="row card" style="gap:24rpx;padding:20rpx" wx:for="{{list}}" wx:key="name" bindtap="choose" data-name="{{item.name}}">
      <view class="ph" style="width:124rpx;height:124rpx"></view>
      <view class="col flex1" style="gap:8rpx">
        <view style="font-size:32rpx;font-weight:600">{{item.name}}</view>
        <view style="font-size:22rpx;color:#8A8072">{{item.meta}}</view>
        <view style="font-size:22rpx;color:#3A342B">{{item.kcal}} 千卡 · {{item.starText}}</view>
      </view>
      <view style="font-size:24rpx;color:#A93226">选它</view>
    </view>
  </view>

</view>
